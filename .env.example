# ==========================================================================
#  PLANTILLA DEL .env — copiar a .env y completar
# ==========================================================================
#     cp .env.example .env
#
# El .env guarda SOLO secretos y lo propio de cada máquina. El resto de la
# configuración (modelos de IA, umbrales del RAG, URLs de portales, IDs de
# Google Sheets, casillas de correo, CORS, rutas de storage) vive en
# backend/app/config.py y viaja con el deploy. Ver docs/CONFIGURACION.md.
#
# Cualquier variable agregada acá PISA el default de config.py: útil para
# probar algo en dev, peligroso si queda pegada (silencia cambios del código).
# ==========================================================================

# --- Entorno --------------------------------------------------------------
# "dev" o "prod". Dev y prod comparten la base: cada proceso solo toma el
# trabajo de su entorno y los jobs "solo prod" del scheduler no corren en dev.
# Default de config.py: prod (un dev sin esta línea se comporta como prod).
ENVIRONMENT=dev

# --- Base de datos --------------------------------------------------------
# Conexiones de la app y del chatbot SQL. Los valores de abajo apuntan a la base
# de demostración de db/docker-compose.yml (ver db/README.md); si le cambiaste el
# puerto (DEMO_SQL_PORT) o la clave (DEMO_SA_PASSWORD), cambialos acá también.
CONNECTION_STRING="mssql+pyodbc://sa:Demo_ContactCenter_2026@127.0.0.1:1433/Acme?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes"
CONNECTION_STRING_chatbot="mssql+pyodbc://sa:Demo_ContactCenter_2026@127.0.0.1:1433/Acme?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes"

# --- Seguridad ------------------------------------------------------------
# Clave de firma de los JWT. Generar una propia por entorno; rotarla invalida
# todas las sesiones abiertas:  python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY="cambiar-por-una-clave-propia"
# Clave de sesión de Flask (frontend). Sin definirla se usa un valor de
# desarrollo embebido en frontend/config.py, que NO sirve para producción.
# FLASK_SECRET_KEY=""

# --- API keys -------------------------------------------------------------
# Con el valor de ejemplo la aplicación arranca y funciona, salvo lo que llama a
# Gemini (auditar, chatbots, asistentes): para eso poné una clave propia de
# https://aistudio.google.com/apikey. No las dejes vacías: el backend no arranca.
GEMINI_AUDITORIA_API_KEY="SIN_CONFIGURAR"
GEMINI_CHATBOT_API_KEY="SIN_CONFIGURAR"
# Legado sin uso: config.py las exige pero ningún código las usa. Mientras
# sigan declaradas, alcanza con cualquier valor no vacío.
DEEPGRAM_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTESERVICE_API_KEY=""

# --- Credenciales de plataformas (las URLs están en config.py) ------------
VERINT_USER=""
VERINT_PASS=""
CXONE_USER=""
CXONE_PASS=""
CXONE_TOPC=""
YOIZEN_USER=""
YOIZEN_PASS=""
MITROL_USER=""
MITROL_PASS=""
HERMES_USER=""
HERMES_PASS=""
CYT_USER=""
CYT_PASS=""
ASTERVOIP_USER=""
ASTERVOIP_PASS=""
# Genesys Cloud de Benefix (opcionales: sin ellas no se procesa Benefix).
GENESYS_USER=""
GENESYS_PASS=""
# Portal de informes de Enerval. No pasan por config.py: las lee solo
# scripts/enerval_informe_ivr.py (cron del IVR de Voltara).
USER_ENERVAL=""
PASS_ENERVAL=""

# --- Correo (contraseñas de aplicación; las casillas están en config.py) --
RRHH_MAIL_PASS=""
ENVIOS_OPERACIONES_PASS=""
CALIDAD1_PASS=""

# --- Qdrant ---------------------------------------------------------------
# Vacía = sin autenticación (Qdrant local).
QDRANT_API_KEY=""

# ==========================================================================
#  OPCIONALES — solo si esta máquina difiere del default de config.py
# ==========================================================================
# Logs e índices de los chatbots. En un servidor van en /var/www/...; para
# probar en una máquina propia alcanza con una carpeta del repo (está en .gitignore).
DEFAULT_LOG_DIR="storage/main_logs"
CHATBOT_STORAGE_ROOT="storage/chatbots"
# CHROME_BINARY_LOCATION="/usr/bin/google-chrome"
# CORS_ORIGINS="http://localhost:7000,..."
# LOG_LEVEL="INFO"
