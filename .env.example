# ==========================================================================
#  PLANTILLA DEL .env — copiar a .env y completar
# ==========================================================================
#     cp .env.example .env
#
# El .env guarda SOLO secretos y lo propio de cada máquina. El resto de la
# configuración (modelos de IA, umbrales del RAG, URLs de portales, IDs de
# Google Sheets, casillas de correo, CORS, rutas de storage) vive en
# backend/app/config.py y viaja con el deploy. Ver docs/CONFIGURACION.md.
#
# Cualquier variable agregada acá PISA el default de config.py: útil para
# probar algo en dev, peligroso si queda pegada (silencia cambios del código).
# ==========================================================================

# --- Entorno --------------------------------------------------------------
# "dev" o "prod". Dev y prod comparten la base: cada proceso solo toma el
# trabajo de su entorno y los jobs "solo prod" del scheduler no corren en dev.
# Default de config.py: prod (un dev sin esta línea se comporta como prod).
ENVIRONMENT=dev

# --- Base de datos --------------------------------------------------------
# Credencial de solo lectura del MCP de SQL (mssql_mcp.py, herramienta de
# desarrollo; la aplicación no la usa).
mssql_server=''
mssql_read_user=''
mssql_read_password=''
# Conexiones de la app y del chatbot SQL.
CONNECTION_STRING="mssql+pyodbc://USUARIO:CLAVE@SERVIDOR/Acme?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes"
CONNECTION_STRING_chatbot="mssql+pyodbc://USUARIO:CLAVE@SERVIDOR/Acme?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes"

# --- Seguridad ------------------------------------------------------------
# Clave de firma de los JWT. Generar una propia por entorno; rotarla invalida
# todas las sesiones abiertas:  python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=""
# Clave de sesión de Flask (frontend). En PRODUCCIÓN no va acá: vive en
# /etc/systemd/system/frontend.service junto con FASTAPI_URL. Sin definirla se
# usa un valor embebido en frontend/config.py, que NO sirve para producción.
# FLASK_SECRET_KEY=""

# --- API keys -------------------------------------------------------------
GEMINI_AUDITORIA_API_KEY=""
GEMINI_CHATBOT_API_KEY=""
# Legado sin uso: config.py las exige pero ningún código las usa. Mientras
# sigan declaradas, alcanza con cualquier valor no vacío.
DEEPGRAM_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTESERVICE_API_KEY=""

# --- Credenciales de plataformas (las URLs están en config.py) ------------
VERINT_USER=""
VERINT_PASS=""
CXONE_USER=""
CXONE_PASS=""
CXONE_TOPC=""
YOIZEN_USER=""
YOIZEN_PASS=""
MITROL_USER=""
MITROL_PASS=""
HERMES_USER=""
HERMES_PASS=""
CYT_USER=""
CYT_PASS=""
ASTERVOIP_USER=""
ASTERVOIP_PASS=""
# Genesys Cloud de Benefix (opcionales: sin ellas no se procesa Benefix).
GENESYS_USER=""
GENESYS_PASS=""
# Portal de informes de Enerval. No pasan por config.py: las lee solo
# scripts/enerval_informe_ivr.py (cron del IVR de Voltara).
USER_ENERVAL=""
PASS_ENERVAL=""

# --- Correo (contraseñas de aplicación; las casillas están en config.py) --
RRHH_MAIL_PASS=""
ENVIOS_OPERACIONES_PASS=""
CALIDAD1_PASS=""

# --- Power BI (MCP powerbi_mcp.py, herramienta de desarrollo) --------------
# Opcional: la aplicación no lo usa y los servidores no lo tienen configurado.
# App registration de Entra ID. Con licencia PPU hay que usar device_code
# (cliente público + `python powerbi_mcp.py --login` una vez): los service
# principals no pueden acceder a workspaces Premium por usuario.
powerbi_tenant_id=''
powerbi_client_id=''
# 'device_code' (default, sirve para PPU) o 'service_principal'.
# powerbi_auth_mode='device_code'
# Solo para el modo service_principal:
# powerbi_client_secret=''
# Workspace por defecto y permiso para disparar refreshes:
# powerbi_workspace_id=''
# powerbi_allow_write=false

# --- Qdrant ---------------------------------------------------------------
# Vacía = sin autenticación (Qdrant local).
QDRANT_API_KEY=""

# ==========================================================================
#  OPCIONALES — solo si esta máquina difiere del default de config.py
# ==========================================================================
# DEFAULT_LOG_DIR="/var/www/chatcsva/storage/main_logs"
# CHATBOT_STORAGE_ROOT="/var/www/chatcsva/storage/chatbots"
# CHROME_BINARY_LOCATION="/usr/bin/google-chrome"
# CORS_ORIGINS="http://localhost:7000,..."
# LOG_LEVEL="INFO"
